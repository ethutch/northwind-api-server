app:
  apicurio:
    url      : http://localhost:8081
    group-id : com.jetsys.northwind
    artifacts:
      - OrderEvent
      - CustomerEvent

server:
  port: 18080
  servlet:
    context-path: ""

springdoc:
  api-docs:
    enabled: true
    path: /v3/api-docs
  swagger-ui:
    enabled: false
  # Optional: speed up startup
  cache:
    disabled: true

spring:
  profiles:
    active: openapi-gen
  application:
    name: "northwind-api-server"
  datasource :
    url              : "jdbc:postgresql://localhost:5432/northwind"
    username         : "postgres"
    password         : "passw0rd!"
    driver-class-name: org.postgresql.Driver

    hikari           :
      connection-timeout      : 20000
      idle-timeout            : 30000
      max-lifetime            : 1800000
      maximum-pool-size       : 3
      minimum-idle            : 1
      pool-name               : PostgresHikariCP
      connection-test-query   : SELECT 1
      leak-detection-threshold: 3000
  security   :
    enabled: false

  jpa        :
    show-sql         : false
    database-platform: org.hibernate.dialect.PostgreSQLDialect
    hibernate        :
      ddl-auto: none

